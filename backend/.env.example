PROJECT_NAME="El Mundo del Cabello — API"
ENVIRONMENT=local

# SQLite for local dev (zero setup). No driver install needed beyond aiosqlite.
# Switch to Postgres in production:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/peluq
DATABASE_URL=sqlite+aiosqlite:///./peluq.db

SQL_ECHO=false

# Cambiar obligatoriamente fuera de desarrollo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-admin-password>
AUTH_SECRET=<random-secret-at-least-32-characters>
AUTH_TOKEN_TTL_MINUTES=480
ADMIN_PIN=<admin-reassignment-pin>

# Comma-separated list of allowed origins. Or a JSON list.
# Incluye 5174 porque es el puerto alternativo documentado para la demo local.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174"]
